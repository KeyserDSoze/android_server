#!/sbin/openrc-run
name="opencode"
description="OpenCode AI Server (standalone mode)"
supervisor="supervise-daemon"
command="/bin/sh"
command_args="-c 'PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin; export OPENCODE_SERVER_PASSWORD=\"\${OPENCODE_UI_PASSWORD:-}\"; exec opencode serve --hostname \"\${OPENCODE_HOSTNAME:-127.0.0.1}\" --port \"\${OPENCODE_PORT:-3000}\"'"
output_log="/root/logs/opencode.log"
error_log="/root/logs/opencode.log"
respawn_delay=5
respawn_max=0

start_pre() {
  checkpath --directory --mode 0755 /root/logs
  if [ -f /etc/conf.d/openchamber ] && [ "${OPENCODE_STANDALONE:-false}" != "true" ]; then
    eerror "OpenCode standalone is disabled because OpenChamber manages OpenCode. Set OPENCODE_STANDALONE=true to override."
    return 1
  fi
}

depend() {
  need net
}
