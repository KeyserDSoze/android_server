#!/bin/sh
if [ -f /etc/alpine-release ]; then OS_ID=alpine; else OS_ID=debian; fi

if [ -x /usr/local/bin/aserv-services-install ]; then
  /usr/local/bin/aserv-services-install
fi

for s in openchamber opencode codex-proxy cloudflared sshd docker tailscale; do
  if [ "$OS_ID" = "debian" ]; then
    systemctl is-enabled "$s" >/dev/null 2>&1 \
      && systemctl restart "$s" 2>/dev/null && printf 'restarted: %s\n' "$s" || true
  else
    [ -x "/etc/init.d/$s" ] && rc-service "$s" restart 2>/dev/null && printf 'restarted: %s\n' "$s" || true
  fi
done
aserv-status
