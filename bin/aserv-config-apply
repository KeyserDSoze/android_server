#!/bin/sh
set -eu

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
CONFIG_DIR="$BASE_DIR/config"

fail() { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
log() { printf '\033[1;32m>> %s\033[0m\n' "$*"; }

[ "$(id -u)" = 0 ] || fail "Run as root."
[ $# -eq 1 ] || fail "Usage: aserv-config-apply <profile-name-or-enc-file>"

_profile="$1"
case "$_profile" in
  *.enc) _chosen="$_profile" ;;
  *) _chosen="$CONFIG_DIR/${_profile}.enc" ;;
esac
[ -f "$_chosen" ] || fail "Encrypted profile not found: $_chosen"

printf 'Decryption password for %s: ' "$(basename "$_chosen")"
stty -echo 2>/dev/null || true
read _password
stty echo 2>/dev/null || true
printf '\n'

_passfile="$(mktemp /tmp/aserv-pass.XXXXXX)"
_tmp="$(mktemp /tmp/aserv-config.XXXXXX)"
_clean="$(mktemp /tmp/aserv-config-clean.XXXXXX)"
trap 'rm -f "$_passfile" "$_tmp" "$_clean"' EXIT HUP INT TERM
chmod 600 "$_passfile"
printf '%s' "$_password" > "$_passfile"
unset _password

if ! openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 \
    -in "$_chosen" -out "$_tmp" -pass "file:$_passfile" 2>/dev/null; then
  fail "Could not decrypt $(basename "$_chosen")."
fi
tr -d '\r' < "$_tmp" > "$_clean"
. "$_clean"

case "${CONFIG_NAME:-}" in
  '') fail "CONFIG_NAME is missing from the decrypted profile." ;;
esac

if [ -f /etc/alpine-release ]; then
  OS_ID=alpine
  CONF_DIR=/etc/conf.d
else
  OS_ID=debian
  CONF_DIR=/etc/default
fi

log "Applying profile: ${CONFIG_NAME}"
mkdir -p /etc/aserv /root/logs

cat > "$CONF_DIR/opencode" <<CFG
OPENCODE_UI_PASSWORD="${OPENCODE_UI_PASSWORD:-}"
OPENCODE_PORT="${OPENCODE_PORT:-3000}"
OPENCODE_HOSTNAME="${OPENCODE_HOSTNAME:-0.0.0.0}"
CFG

cat > "$CONF_DIR/openchamber" <<CFG
OPENCHAMBER_PASSWORD="${OPENCHAMBER_PASSWORD:-}"
OPENCHAMBER_PORT="${OPENCHAMBER_PORT:-3210}"
CFG

cat > "$CONF_DIR/codex-proxy" <<CFG
CODEX_PROXY_PORT="${CODEX_PROXY_PORT:-22001}"
CODEX_NGINX_PROXY_PORT="${CODEX_NGINX_PROXY_PORT:-22000}"
CODEX_NGINX_PROXY_CORS_ORIGIN="${CODEX_NGINX_PROXY_CORS_ORIGIN:-*}"
CODEX_PROXY_API_KEY="${CODEX_PROXY_API_KEY:-}"
CFG
chmod 600 "$CONF_DIR/codex-proxy" "$CONF_DIR/opencode" "$CONF_DIR/openchamber"

if [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
  printf '%s\n' "$CLOUDFLARE_TUNNEL_TOKEN" > /etc/aserv/cloudflare-token
  chmod 600 /etc/aserv/cloudflare-token
fi
[ -n "${CLOUDFLARE_TUNNEL_NAME:-}" ] && printf '%s\n' "$CLOUDFLARE_TUNNEL_NAME" > /etc/aserv/tunnel-name
[ -n "${CLOUDFLARE_HOSTNAME:-}" ] && printf '%s\n' "$CLOUDFLARE_HOSTNAME" > /etc/aserv/hostname

if [ -x /usr/local/lib/aserv/codex-nginx.sh ]; then
  /usr/local/lib/aserv/codex-nginx.sh
elif [ -x "$BASE_DIR/modules/codex-nginx.sh" ]; then
  "$BASE_DIR/modules/codex-nginx.sh"
else
  printf 'WARNING: Nginx Codex module not found; skipped Nginx regeneration.\n' >&2
fi

if [ "$OS_ID" = debian ]; then
  for _unit in openchamber.service opencode.service codex-proxy.service; do
    _source="$BASE_DIR/systemd/$_unit"
    [ -f "$_source" ] || _source="/usr/local/lib/aserv/systemd/$_unit"
    [ -f "$_source" ] && install -m 0644 "$_source" "/etc/systemd/system/$_unit"
  done
  systemctl daemon-reload
  for _service in openchamber opencode codex-proxy nginx cloudflared; do
    systemctl is-enabled "$_service" >/dev/null 2>&1 || continue
    systemctl restart "$_service" >/dev/null 2>&1 || printf 'WARNING: %s did not start; check systemctl status/logs.\n' "$_service" >&2
  done
else
  for _service in openchamber opencode codex-proxy cloudflared; do
    _source="$BASE_DIR/openrc/$_service"
    [ -f "$_source" ] || _source="/usr/local/lib/aserv/openrc/$_service"
    [ -f "$_source" ] && install -m 0755 "$_source" "/etc/init.d/$_service"
  done
  for _service in openchamber opencode codex-proxy nginx cloudflared; do
    [ -x "/etc/init.d/$_service" ] && rc-service "$_service" restart >/dev/null 2>&1 || true
  done
fi

log "Profile applied and services restarted."
