#!/bin/sh
set -eu

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
CACHE_DIR="/usr/local/lib/aserv"

log() { printf '\033[1;32m>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARNING: %s\033[0m\n' "$*" >&2; }
fail() { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || fail "Run as root: sudo aserv-services-install"

if [ -f /etc/alpine-release ]; then
  OS_ID=alpine
  CONF_DIR=/etc/conf.d
else
  OS_ID=debian
  CONF_DIR=/etc/default
fi

set_simple_assignment() {
  _file="$1"
  _key="$2"
  _value="$3"
  [ -f "$_file" ] || return 0
  if grep -q "^${_key}=" "$_file"; then
    sed -i "s|^${_key}=.*|${_key}=\"${_value}\"|" "$_file"
  else
    printf '%s="%s"\n' "$_key" "$_value" >> "$_file"
  fi
}

get_simple_assignment() {
  _file="$1"
  _key="$2"
  [ -f "$_file" ] || return 0
  awk -F= -v key="$_key" '
    $1 == key {
      value=$2
      gsub(/^[[:space:]\"]+|[[:space:]\"]+$/, "", value)
      result=value
    }
    END { print result }
  ' "$_file"
}

OPENCODE_CONF="$CONF_DIR/opencode"
OPENCHAMBER_CONF="$CONF_DIR/openchamber"

# Reconcile configuration written by older installers. OpenChamber-managed
# OpenCode is loopback-only and uses the configured OpenCode port.
OPENCODE_PORT_VALUE="$(get_simple_assignment "$OPENCODE_CONF" OPENCODE_PORT)"
case "$OPENCODE_PORT_VALUE" in
  ''|*[!0-9]*) OPENCODE_PORT_VALUE=3000 ;;
esac

OPENCODE_STANDALONE_VALUE="$(get_simple_assignment "$OPENCODE_CONF" OPENCODE_STANDALONE)"
[ "$OPENCODE_STANDALONE_VALUE" = "true" ] || OPENCODE_STANDALONE_VALUE=false

if [ -f "$OPENCODE_CONF" ]; then
  set_simple_assignment "$OPENCODE_CONF" OPENCODE_STANDALONE "$OPENCODE_STANDALONE_VALUE"
  if [ "$OPENCODE_STANDALONE_VALUE" != "true" ]; then
    set_simple_assignment "$OPENCODE_CONF" OPENCODE_HOSTNAME "127.0.0.1"
  fi
fi

if [ -f "$OPENCHAMBER_CONF" ]; then
  [ -n "$(get_simple_assignment "$OPENCHAMBER_CONF" OPENCHAMBER_HOST)" ] \
    || set_simple_assignment "$OPENCHAMBER_CONF" OPENCHAMBER_HOST "127.0.0.1"
  # OpenChamber reads OPENCODE_PORT from its own environment when it launches
  # managed OpenCode. Keep this synchronized with the OpenCode configuration.
  set_simple_assignment "$OPENCHAMBER_CONF" OPENCODE_PORT "$OPENCODE_PORT_VALUE"
  [ -n "$(get_simple_assignment "$OPENCHAMBER_CONF" OPENCHAMBER_OPENCODE_HOSTNAME)" ] \
    || set_simple_assignment "$OPENCHAMBER_CONF" OPENCHAMBER_OPENCODE_HOSTNAME "127.0.0.1"
fi

# Configuration files may contain API/UI passwords.
for _conf in "$OPENCHAMBER_CONF" "$OPENCODE_CONF" "$CONF_DIR/codex-proxy"; do
  [ -f "$_conf" ] && chmod 600 "$_conf"
done

# Warn loudly when a known public OpenChamber hostname is configured without
# an application password. This remains a warning because some deployments
# intentionally enforce authentication in an upstream access proxy.
if [ -f "$OPENCHAMBER_CONF" ] && [ -s /etc/aserv/hostname ]; then
  _password_line="$(grep '^OPENCHAMBER_PASSWORD=' "$OPENCHAMBER_CONF" | tail -n1 || true)"
  case "$_password_line" in
    ''|'OPENCHAMBER_PASSWORD=""'|"OPENCHAMBER_PASSWORD=''")
      warn "OpenChamber has a configured public hostname but no UI password. Set OPENCHAMBER_PASSWORD unless an upstream access proxy provides authentication."
      ;;
  esac
fi

# Prevent unbounded service logs from filling the root filesystem. copytruncate
# works with both systemd append: files and supervise-daemon output files.
mkdir -p /etc/logrotate.d
cat > /etc/logrotate.d/aserv <<'LOGROTATE'
/root/logs/*.log {
    daily
    rotate 14
    maxsize 20M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
LOGROTATE
chmod 644 /etc/logrotate.d/aserv

OPENCODE_STANDALONE_ENABLED=0
if [ "$OPENCODE_STANDALONE_VALUE" = "true" ]; then
  OPENCODE_STANDALONE_ENABLED=1
fi

MANAGED_OPENCODE=0
if [ "$OPENCODE_STANDALONE_ENABLED" = 0 ] && [ -f "$OPENCHAMBER_CONF" ] \
    && { command -v openchamber >/dev/null 2>&1 || [ -x /usr/local/bin/openchamber ] || [ -x /root/.local/bin/openchamber ]; }; then
  MANAGED_OPENCODE=1
fi

if [ "$OS_ID" = debian ]; then
  _found_service=0
  for service_file in "$BASE_DIR"/systemd/*.service; do
    [ -f "$service_file" ] || continue
    _found_service=1
    install -m 0644 "$service_file" "/etc/systemd/system/$(basename "$service_file")"
    printf '  installed systemd unit: %s\n' "$(basename "$service_file")"
  done
  if [ "$_found_service" = 0 ]; then
    for service_file in "$CACHE_DIR"/systemd/*.service; do
      [ -f "$service_file" ] || continue
      install -m 0644 "$service_file" "/etc/systemd/system/$(basename "$service_file")"
      printf '  restored systemd unit: %s\n' "$(basename "$service_file")"
    done
  fi

  systemctl daemon-reload
  for service in openchamber codex-proxy nginx cloudflared; do
    systemctl enable "$service" >/dev/null 2>&1 || true
  done

  if [ "$MANAGED_OPENCODE" = 1 ]; then
    systemctl disable --now opencode >/dev/null 2>&1 || true
    systemctl reset-failed opencode >/dev/null 2>&1 || true
    printf '  opencode: standalone service disabled (managed by OpenChamber on 127.0.0.1:%s)\n' "$OPENCODE_PORT_VALUE"
  else
    systemctl enable opencode >/dev/null 2>&1 || true
  fi
else
  _found_service=0
  for service_file in "$BASE_DIR"/openrc/*; do
    [ -f "$service_file" ] || continue
    _found_service=1
    install -m 0755 "$service_file" "/etc/init.d/$(basename "$service_file")"
    printf '  installed OpenRC service: %s\n' "$(basename "$service_file")"
  done
  if [ "$_found_service" = 0 ]; then
    for service_file in "$CACHE_DIR"/openrc/*; do
      [ -f "$service_file" ] || continue
      install -m 0755 "$service_file" "/etc/init.d/$(basename "$service_file")"
      printf '  restored OpenRC service: %s\n' "$(basename "$service_file")"
    done
  fi

  for service in openchamber codex-proxy nginx cloudflared; do
    rc-update add "$service" default >/dev/null 2>&1 || true
  done

  if [ "$MANAGED_OPENCODE" = 1 ]; then
    rc-service opencode stop >/dev/null 2>&1 || true
    rc-update del opencode default >/dev/null 2>&1 || true
    printf '  opencode: standalone service disabled (managed by OpenChamber on 127.0.0.1:%s)\n' "$OPENCODE_PORT_VALUE"
  else
    rc-update add opencode default >/dev/null 2>&1 || true
  fi
fi

log "Service definitions, AI lifecycle and log rotation installed."
