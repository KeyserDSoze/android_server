#!/bin/sh
# aserv-update-ai — Stop, update and restart OpenChamber + OpenCode
#
# OpenChamber manages its own OpenCode server by default.  The standalone
# opencode service remains supported when OpenChamber is not configured.

set -eu

log()  { printf '\n\033[1;32m== %s ==\033[0m\n' "$*"; }
warn() { printf '\n\033[1;33m!! %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m   OK: %s\033[0m\n' "$*"; }

if [ -f /etc/alpine-release ]; then
  OS_ID=alpine
  CONF_DIR=/etc/conf.d
else
  OS_ID=debian
  CONF_DIR=/etc/default
fi

ASERV_DIR="${ASERV_REPO_DIR:-$PWD}"
if [ -x /usr/local/bin/aserv-services-install ]; then
  /usr/local/bin/aserv-services-install
elif [ -x "$ASERV_DIR/bin/aserv-services-install" ]; then
  "$ASERV_DIR/bin/aserv-services-install"
fi

MANAGED_OPENCODE=0
if [ -f "$CONF_DIR/openchamber" ] && { command -v openchamber >/dev/null 2>&1 || [ -x /usr/local/bin/openchamber ] || [ -x /root/.local/bin/openchamber ]; }; then
  MANAGED_OPENCODE=1
fi

svc_stop() {
  if [ "$OS_ID" = debian ]; then systemctl stop "$1" 2>/dev/null || true
  else rc-service "$1" stop 2>/dev/null || true; fi
}
svc_start() {
  if [ "$OS_ID" = debian ]; then systemctl restart "$1" 2>/dev/null
  else rc-service "$1" restart 2>/dev/null; fi
}
svc_status() {
  if [ "$OS_ID" = debian ]; then systemctl status "$1" --no-pager -l 2>/dev/null || true
  else rc-service "$1" status 2>/dev/null || true; fi
}

log "Stopping AI services"
# Stop OpenChamber first so its managed child is shut down cleanly.
svc_stop openchamber
# Stop a stale/standalone OpenCode instance as well.  The service installer
# disables it in managed mode, but this also cleans up older installations.
svc_stop opencode

log "Updating OpenChamber"
if command -v npm >/dev/null 2>&1; then
  npm install -g @openchamber/web \
    && ok "openchamber updated: $(openchamber --version 2>/dev/null | head -1 || echo ok)" \
    || warn "openchamber npm update failed."
else
  warn "npm not found — skipping openchamber update."
fi

log "Updating OpenCode"
_oc_arch="$(uname -m)"
case "$_oc_arch" in aarch64|arm64) _oc_arch="arm64" ;; *) _oc_arch="x64" ;; esac

if [ -f /etc/alpine-release ] || (ldd --version 2>&1 | grep -q musl 2>/dev/null); then
  _url="https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${_oc_arch}-musl.tar.gz"
  printf '  Downloading musl binary from: %s\n' "$_url"
  curl -fL "$_url" -o /tmp/opencode.tar.gz 2>/dev/null \
    && tar -xzf /tmp/opencode.tar.gz -C /tmp 2>/dev/null \
    && install -m 755 /tmp/opencode /usr/local/bin/opencode \
    && ok "opencode updated: $(opencode --version 2>/dev/null | head -1 || echo ok)" \
    || warn "opencode musl update failed."
  rm -f /tmp/opencode.tar.gz /tmp/opencode
else
  if command -v npm >/dev/null 2>&1; then
    npm_config_ignore_scripts=false npm install -g --foreground-scripts --ignore-scripts=false --allow-scripts=opencode-ai opencode-ai@latest 2>/dev/null \
      || warn "opencode-ai npm update failed."
    command -v opencode >/dev/null 2>&1 && ok "opencode: $(opencode --version 2>/dev/null | head -1 || echo ok)"
  else
    warn "npm not found — skipping opencode update."
  fi
fi

# Re-run service installation after updating binaries so an older standalone
# OpenCode unit is disabled when OpenChamber is responsible for the lifecycle.
if [ -x /usr/local/bin/aserv-services-install ]; then
  /usr/local/bin/aserv-services-install
elif [ -x "$ASERV_DIR/bin/aserv-services-install" ]; then
  "$ASERV_DIR/bin/aserv-services-install"
fi

log "Starting AI services"
if [ "$MANAGED_OPENCODE" = 1 ]; then
  svc_start openchamber \
    && ok "openchamber started (OpenCode managed by OpenChamber)" \
    || warn "openchamber failed to start — check: aserv-logs openchamber"
else
  svc_start opencode \
    && ok "opencode started" \
    || warn "opencode failed to start — check: aserv-logs opencode"
  if [ -f "$CONF_DIR/openchamber" ]; then
    svc_start openchamber \
      && ok "openchamber started" \
      || warn "openchamber failed to start — check: aserv-logs openchamber"
  fi
fi

log "Status"
printf '\n--- openchamber ---\n'
svc_status openchamber
if [ "$MANAGED_OPENCODE" = 1 ]; then
  printf '\n--- opencode ---\nmanaged by OpenChamber; standalone service intentionally disabled\n'
else
  printf '\n--- opencode ---\n'
  svc_status opencode
fi
