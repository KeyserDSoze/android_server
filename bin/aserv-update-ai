#!/bin/sh
# aserv-update-ai — Stop, update and restart OpenChamber + OpenCode
#
# OpenChamber manages its own OpenCode server by default. The standalone
# opencode service remains supported when OpenChamber is not configured or
# OPENCODE_STANDALONE=true is explicitly set.

set -eu

log()  { printf '\n\033[1;32m== %s ==\033[0m\n' "$*"; }
warn() { printf '\n\033[1;33m!! %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m   OK: %s\033[0m\n' "$*"; }

if [ -f /etc/alpine-release ]; then
  OS_ID=alpine
  CONF_DIR=/etc/conf.d
else
  OS_ID=debian
  CONF_DIR=/etc/default
fi

[ "$(id -u)" = 0 ] || { warn "Run as root: sudo aserv-update-ai"; exit 1; }

ASERV_DIR="${ASERV_REPO_DIR:-}"
if [ -z "$ASERV_DIR" ] && [ -f "$PWD/modules/opencode.sh" ]; then
  ASERV_DIR="$PWD"
fi
if [ -z "$ASERV_DIR" ] && [ -r /etc/aserv/repository-path ]; then
  IFS= read -r ASERV_DIR < /etc/aserv/repository-path || true
fi

# Resolve V2 before stopping any running services.
OPENCODE_MODULE="/usr/local/lib/aserv/opencode.sh"
if [ ! -f "$OPENCODE_MODULE" ] && [ -n "$ASERV_DIR" ] && [ -f "$ASERV_DIR/modules/opencode.sh" ]; then
  OPENCODE_MODULE="$ASERV_DIR/modules/opencode.sh"
fi
if [ ! -f "$OPENCODE_MODULE" ]; then
  warn "OpenCode V2 module missing. From the checkout run: sudo sh bin/aserv-update-commands"
  exit 1
fi
UPDATE_FAILED=0
if [ -x /usr/local/bin/aserv-services-install ]; then
  /usr/local/bin/aserv-services-install
elif [ -x "$ASERV_DIR/bin/aserv-services-install" ]; then
  "$ASERV_DIR/bin/aserv-services-install"
fi

OPENCODE_STANDALONE_ENABLED=0
if [ -f "$CONF_DIR/opencode" ] && grep -Eq '^OPENCODE_STANDALONE="?true"?$' "$CONF_DIR/opencode"; then
  OPENCODE_STANDALONE_ENABLED=1
fi

MANAGED_OPENCODE=0
if [ "$OPENCODE_STANDALONE_ENABLED" = 0 ] && [ -f "$CONF_DIR/openchamber" ] && { command -v openchamber >/dev/null 2>&1 || [ -x /usr/local/bin/openchamber ] || [ -x /root/.local/bin/openchamber ]; }; then
  MANAGED_OPENCODE=1
fi

svc_stop() {
  if [ "$OS_ID" = debian ]; then systemctl stop "$1" 2>/dev/null || true
  else rc-service "$1" stop 2>/dev/null || true; fi
}
svc_start() {
  if [ "$OS_ID" = debian ]; then systemctl restart "$1" 2>/dev/null
  else rc-service "$1" restart 2>/dev/null; fi
}
svc_status() {
  if [ "$OS_ID" = debian ]; then systemctl status "$1" --no-pager -l 2>/dev/null || true
  else rc-service "$1" status 2>/dev/null || true; fi
}

log "Stopping AI services"
# Stop OpenChamber first so its managed child is shut down cleanly.
svc_stop openchamber
# Stop a stale/standalone OpenCode instance as well. The service installer
# disables it in managed mode, but this also cleans up older installations.
svc_stop opencode

log "Updating OpenChamber"
if command -v npm >/dev/null 2>&1; then
  # Explicitly approve only these two native dependencies for global installs.
  if npm install -g --allow-scripts=node-pty,msgpackr-extract @openchamber/web; then
    ok "openchamber updated: $(openchamber --version 2>/dev/null | head -1 || echo ok)"
  else
    warn "openchamber npm update failed."
    UPDATE_FAILED=1
  fi
else
  warn "npm not found — skipping openchamber update."
  UPDATE_FAILED=1
fi

log "Updating OpenCode 2"
if sh "$OPENCODE_MODULE"; then
  ok "opencode: $(/usr/local/bin/opencode --version 2>/dev/null | head -1)"
else
  warn "OpenCode 2 update failed."
  UPDATE_FAILED=1
fi

# Re-run service installation after updating binaries so an older standalone
# OpenCode unit is disabled when OpenChamber is responsible for the lifecycle.
if [ -x /usr/local/bin/aserv-services-install ]; then
  /usr/local/bin/aserv-services-install
elif [ -x "$ASERV_DIR/bin/aserv-services-install" ]; then
  "$ASERV_DIR/bin/aserv-services-install"
fi

log "Starting AI services"
if [ "$MANAGED_OPENCODE" = 1 ]; then
  if svc_start openchamber; then
    ok "openchamber started (OpenCode managed by OpenChamber)"
  else
    warn "openchamber failed to start — check: aserv-logs openchamber"
    UPDATE_FAILED=1
  fi
else
  if svc_start opencode; then
    ok "opencode started"
  else
    warn "opencode failed to start — check: aserv-logs opencode"
    UPDATE_FAILED=1
  fi
  if [ -f "$CONF_DIR/openchamber" ]; then
    if svc_start openchamber; then
      ok "openchamber started"
    else
      warn "openchamber failed to start — check: aserv-logs openchamber"
      UPDATE_FAILED=1
    fi
  fi
fi

log "Status"
printf '\n--- openchamber ---\n'
svc_status openchamber
if [ "$MANAGED_OPENCODE" = 1 ]; then
  printf '\n--- opencode ---\nmanaged by OpenChamber; standalone service intentionally disabled\n'
else
  printf '\n--- opencode ---\n'
  svc_status opencode
fi

exit "$UPDATE_FAILED"
