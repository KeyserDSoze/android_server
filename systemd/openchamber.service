[Unit]
Description=OpenChamber UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/openchamber
ExecStart=/bin/bash -c 'export OPENCHAMBER_UI_PASSWORD="$OPENCHAMBER_PASSWORD"; PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin; cmd=$(command -v openchamber || true); test -n "$cmd" || { echo "openchamber command not found in PATH: $PATH" >&2; exit 127; }; exec "$cmd" --host "${OPENCHAMBER_HOST:-127.0.0.1}" --port "${OPENCHAMBER_PORT:-3210}" --foreground'
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/root/logs/openchamber.log
StandardError=append:/root/logs/openchamber.log

[Install]
WantedBy=multi-user.target
