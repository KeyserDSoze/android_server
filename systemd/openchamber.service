[Unit]
Description=OpenChamber UI
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/default/openchamber
ExecStart=/bin/bash -c '. /etc/default/openchamber; PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin; cmd=$(command -v openchamber || true); test -n "$cmd" || { echo "openchamber command not found in PATH: $PATH" >&2; exit 127; }; exec "$cmd" --host 127.0.0.1 --ui-password "$OPENCHAMBER_PASSWORD" --port "${OPENCHAMBER_PORT:-3210}"'
Restart=on-failure
RestartSec=5
StandardOutput=append:/root/logs/openchamber.log
StandardError=append:/root/logs/openchamber.log

[Install]
WantedBy=multi-user.target
